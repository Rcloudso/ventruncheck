---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  optionA?: string;
  optionB?: string;
}

const { title, description, optionA, optionB } = Astro.props;
const vs = optionA && optionB ? `${optionA} vs ${optionB}` : 'Side-by-side method types';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<BaseLayout title={title} description={description} wide>
  <article class="prose">
    <span class="type-badge">
      <img src={`${base}icons/type-compare.svg`} alt="" width="14" height="14" />
      Compare
    </span>
    <h1>{title}</h1>
    <p class="page-purpose">{vs} — when to pick each, and when neither fits.</p>
    {description && <p class="lede">{description}</p>}
    <slot />
    <aside class="disclosure-blurb">
      Product links use <code>?ref=PENDING</code> placeholders only. See
      <a href={`${base}disclosure`}>affiliate disclosure</a>.
    </aside>
  </article>
</BaseLayout>
