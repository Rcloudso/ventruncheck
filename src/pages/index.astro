---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const compares = await getCollection('compare');
const checklists = await getCollection('checklist');
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<BaseLayout
  title="VentRunCheck — Dryer vent cleaning guides"
  description="Practical dryer vent cleaning guidance for homeowners: DIY vs pro, tool comparisons, and safety checklists."
>
  <h1>Dryer vent cleaning, without the hype</h1>
  <p class="lede">
    VentRunCheck is a small static directory for one niche: dryer vents that do not move air.
    Clothes take forever to dry, lint builds up, and quotes sometimes only clean the first few feet.
    We focus on decisions, tool <em>types</em>, and stop conditions — not hard-sell brand rankings.
  </p>

  <ul class="card-list">
    {guides.map((entry) => (
      <li class="card">
        <h2><a href={`${base}guides/${entry.slug}`}>{entry.data.title}</a></h2>
        <p>{entry.data.description}</p>
      </li>
    ))}
    {compares.map((entry) => (
      <li class="card">
        <h2><a href={`${base}compare/${entry.slug}`}>{entry.data.title}</a></h2>
        <p>{entry.data.description}</p>
      </li>
    ))}
    {checklists.map((entry) => (
      <li class="card">
        <h2><a href={`${base}checklist/${entry.slug}`}>{entry.data.title}</a></h2>
        <p>{entry.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
